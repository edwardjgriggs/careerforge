{
  "name": "@careerforge/collector-git",
  "version": "0.2.1",
  "type": "module",
  "description": "Git collector. Turns commit history into Evidence.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwardjgriggs/careerforge.git",
    "directory": "collectors/git"
  },
  "homepage": "https://github.com/edwardjgriggs/careerforge#readme",
  "bugs": "https://github.com/edwardjgriggs/careerforge/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@careerforge/domain": "0.2.1",
    "@careerforge/collect": "0.2.1"
