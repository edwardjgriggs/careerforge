{
  "name": "@careerforge/cli",
  "version": "0.2.0",
  "type": "module",
  "description": "CareerForge command-line interface: collect evidence of your work, group it into work units, generate claim-checked career assets, and gate everything that would leave your machine. Install `careerforge` instead unless you are depending on it programmatically.",
  "keywords": [
    "careerforge",
    "resume",
    "career",
    "local-first",
    "provenance",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwardjgriggs/careerforge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/edwardjgriggs/careerforge#readme",
  "bugs": "https://github.com/edwardjgriggs/careerforge/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@careerforge/collect": "0.2.0",
    "@careerforge/collector-git": "0.2.0",
    "@careerforge/collector-session": "0.2.0",
    "@careerforge/domain": "0.2.0",
    "@careerforge/enrich": "0.2.0",
    "@careerforge/generate": "0.2.0",
    "@careerforge/policy": "0.2.0",
    "@careerforge/store": "0.2.0",
    "@careerforge/ui": "0.2.0"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "bin": {
    "careerforge": "./dist/bin.js"
  }
}
