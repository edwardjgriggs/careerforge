{
  "name": "@careerforge/collect",
  "version": "0.2.0",
  "type": "module",
  "description": "CareerForge collector host, cursors, and the collector conformance suite. Import `describeConformance` to prove a third-party collector satisfies the contract without vendoring anything.",
  "keywords": [
    "careerforge",
    "collector",
    "plugin",
    "conformance",
    "contract-testing"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwardjgriggs/careerforge.git",
    "directory": "packages/collect"
  },
  "homepage": "https://github.com/edwardjgriggs/careerforge#readme",
  "bugs": "https://github.com/edwardjgriggs/careerforge/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@careerforge/domain": "0.2.0",
    "@careerforge/protocol": "0.2.0",
    "@careerforge/store": "0.2.0"
  },
  "scripts": {
    "build": "tsc --build"
  }
}
